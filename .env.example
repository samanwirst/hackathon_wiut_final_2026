# VisionFlow AI — local configuration (copy to .env; never commit .env)

# --- backend (services/api) ---
# Where uploads, snapshots, evidence and the SQLite DB live (gitignored).
VISIONFLOW_DATA_DIR=./data
MAX_UPLOAD_MB=200
# Analysis frame rate: frames per second of video actually run through YOLO.
PROCESS_FPS=5
DETECTOR_MODEL=yolo11n.pt
DETECTOR_CONFIDENCE=0.35
# "cpu" or "cuda" (if a CUDA torch build is installed)
DETECTOR_DEVICE=cpu
# Minimum fraction of container-reported frames that must decode for a run to
# count as complete; a larger shortfall is reported as a failed source (M1-013).
DECODE_MIN_COMPLETENESS=0.9
# NOTE: outbound send_webhook actions were removed in M1 (M1-011/M1-012); the
# SSRF/DNS-rebinding guard could not safely protect the delivery connection
# without a risky custom egress transport. Only the local create_notification
# action ships. There is no WEBHOOK_ALLOWLIST to configure.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Teacher VLM (M2, docs/VLM_ARCHITECTURE.md): event-routed visual reasoning ---
# The Teacher is called ONLY on eligible candidate events for a visual predicate,
# never per frame. Server-only config, separate from user workflow input, pointing
# at an operator-set OpenAI-compatible /v1/chat/completions endpoint. With
# VLM_BASE_URL unset (default) the Teacher is UNAVAILABLE: visual predicates return
# an explicit missing_credentials result and can never confirm an action (honest
# blocker). VLM_API_KEY is optional (only for a private authenticated tunnel).
# NEVER commit secrets. Example target: a self-hosted Qwen2.5-VL via vLLM behind
# a loopback SSH tunnel.
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_CONNECT_TIMEOUT=5
VLM_READ_TIMEOUT=20
VLM_TIMEOUT_SECONDS=25
VLM_MAX_RETRIES=1
VLM_MAX_CONCURRENCY=1
VLM_MAX_IMAGE_BYTES=4194304
VLM_MAX_TOKENS=200
# Bump when the prompt template or preprocessing changes (invalidates cache).
TEACHER_PROMPT_VERSION=v1

# --- VLM router budgets/sampling/cache (M2) ---
VLM_SAMPLE_INTERVAL_SECONDS=2
VLM_COOLDOWN_SECONDS=5
VLM_BUDGET_PER_TASK=50
VLM_CACHE_TTL_SECONDS=600
VLM_CACHE_MAX_ENTRIES=512

# CPU thread cap for detector/VLM/training on limited-RAM hosts.
VISIONFLOW_THREADS=2

# --- frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose ---
COMPOSE_PROJECT_NAME=hackathon-wiut-final-2026
WEB_PORT=3000
API_PORT=8000
